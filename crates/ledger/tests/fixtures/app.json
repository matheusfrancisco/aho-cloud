{
  "api_version": "deploy.aho.cloud/v1",
  "project": "acme-shop",
  "source": { "kind": "git", "repo": "https://github.com/acme/shop", "commit": "0123456789abcdef0123456789abcdef01234567" },
  "build": { "kind": "dockerfile" },
