{
  "name": "@mage/web",
  "private": true,
  "version": "0.0.0",
  "description": "Mage pages, typed API client and generated wire types; mounted by mage/web-app and the aho cloud console",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
